APP_NAME="Remote Center ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Dhaka
APP_URL=http://localhost

# ============================================================
# Database — PostgreSQL (Phase 2)
# ============================================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rcerp
DB_USERNAME=rcerp_app
DB_PASSWORD=

# ============================================================
# Redis (sessions, cache, queue)
# Phase 3: Legacy PHP sessions are stored in Redis DB 1.
# Laravel reads/writes them via LegacySessionBridge.
# ============================================================
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Legacy PHP session Redis DB (must match php.ini session.save_path on VPS).
# Legacy uses: session.save_handler = redis
#              session.save_path = "tcp://127.0.0.1:6379?database=1"
LEGACY_SESSION_REDIS_DB=1

# The session cookie name. MUST match the legacy PHP session.cookie_name.
# Legacy uses PHP default "PHPSESSID" unless overridden in php.ini.
LEGACY_SESSION_COOKIE=PHPSESSID

# ============================================================
# Session (Laravel's own session config — uses the SAME cookie as legacy)
# ============================================================
SESSION_DRIVER=redis
SESSION_CONNECTION=legacy
SESSION_LIFETIME=480
SESSION_COOKIE=PHPSESSID
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAMESITE=lax

# ============================================================
# Auth (simplified — no 2FA/OTP per Phase 0 decision)
# ============================================================
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_RESET_TOKEN_HOURS=1
AUTH_REMEMBER_DAYS=30

# ============================================================
# Cache + Queue
# ============================================================
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# ============================================================
# Mail (password reset — optional in Phase 3)
# ============================================================
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@rcerp.local"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================
# Telegram business alerts (KEPT from Phase 0 — NOT login)
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERTS_ENABLED=true
