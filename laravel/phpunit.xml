<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:2cn8GO0r6OSab790IzGrvPj+siQVQDNsjsWbkzNxRC4="/>
        <env name="APP_DEBUG" value="true"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="QUEUE_DRIVER" value="sync"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PREDIS_DISABLED" value="true"/>

        <!-- Branch Phase 7: Tests use a dedicated test database to avoid
             polluting the dev DB with factory-generated rows. The database
             must already exist and have the full RC_ERP schema applied.
             See docs/migration/branch_phase7_testing.md for setup steps. -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="rcerp_test"/>
        <env name="DB_USERNAME" value="rcerp_app"/>
        <env name="DB_PASSWORD" value=""/>
    </php>
</phpunit>
