From aaddd6886528714c98f5a75e75662a412f0176dd Mon Sep 17 00:00:00 2001
From: Z User <z@container>
Date: Mon, 20 Jul 2026 01:51:07 +0000
Subject: [PATCH 3/5] fix: strip CRLF from entrypoint.sh in Dockerfile
 (bulletproof)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The .gitattributes approach requires users to renormalize their working
copy, which is easy to miss. This fix is BULLETPROOF — it strips \r
characters from entrypoint.sh at Docker BUILD time, so it works
regardless of host OS or Git line-ending settings.

This fixes the 'exec /usr/local/bin/entrypoint.sh: no such file or
directory' error that occurs when Git on Windows converts LF to CRLF.
---
 Dockerfile | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/Dockerfile b/Dockerfile
index ac58ada..69f4116 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -80,8 +80,15 @@ WORKDIR /var/www/laravel
 # -----------------------------------------------------------------------------
 # Entrypoint
 # -----------------------------------------------------------------------------
+# NOTE: We strip Windows CRLF (\r) from the shell script after COPY.
+# Git on Windows converts LF -> CRLF on checkout, which causes the infamous
+# "exec /usr/local/bin/entrypoint.sh: no such file or directory" error
+# because Linux tries to find /bin/bash\r instead of /bin/bash.
+# The sed command removes all \r characters, making it work on any OS.
+# -----------------------------------------------------------------------------
 COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
-RUN chmod +x /usr/local/bin/entrypoint.sh
+RUN sed -i 's/\r$//' /usr/local/bin/entrypoint.sh \
+    && chmod +x /usr/local/bin/entrypoint.sh
 
 ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
 CMD ["php-fpm"]
-- 
