From 1d7ad863fc9a29314a9ecc085928e1854bd04026 Mon Sep 17 00:00:00 2001
From: Z User <z@container>
Date: Mon, 20 Jul 2026 02:07:06 +0000
Subject: [PATCH 4/5] fix: storage permission denied + system_policies table
 missing
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Root cause: The 'app_storage' named volume in docker-compose.yml
OVERLAYED the bind-mounted ./laravel/storage directory. When Docker
creates a named volume, it copies from the image with root ownership.
PHP-FPM runs as www-data and couldn't write to the root-owned volume.

This caused a chicken-and-egg problem:
1. Laravel can't write to storage/logs/laravel.log (permission denied)
2. Because logging fails, migrations can't report errors
3. Because migrations fail silently, system_policies table is never created
4. When a request comes in, CheckSystemPolicy middleware queries
   system_policies → table doesn't exist → 500 error → can't log it

Fix:
1. REMOVED the app_storage named volume from docker-compose.yml
   The bind mount ./laravel:/var/www/laravel now handles storage directly,
   and the entrypoint's chown command actually takes effect.
2. Changed chmod from 775 to 777 for storage/ (more permissive but
   needed for Windows bind mounts where chown may not work)
3. Added 'touch storage/logs/laravel.log' to ensure the file exists
   before PHP-FPM tries to write to it
4. Added || true to chown/chmod for Windows compatibility

After pulling: docker compose down -v && docker compose up -d --build
---
 docker-compose.yml   |  3 ---
 docker/entrypoint.sh | 14 ++++++++++++--
 2 files changed, 12 insertions(+), 5 deletions(-)

diff --git a/docker-compose.yml b/docker-compose.yml
index 6cfdfbc..cae44d4 100644
--- a/docker-compose.yml
+++ b/docker-compose.yml
@@ -176,7 +176,6 @@ services:
     volumes:
       - ./laravel:/var/www/laravel:delegated
       - ./legacy:/var/www/legacy:delegated
-      - app_storage:/var/www/laravel/storage
       - app_vendor:/var/www/laravel/vendor
       - app_node_modules:/var/www/laravel/node_modules
     networks:
@@ -223,8 +222,6 @@ volumes:
     name: rcerp_redis_data
   mysql_archive_data:
     name: rcerp_mysql_archive_data
-  app_storage:
-    name: rcerp_app_storage
   app_vendor:
     name: rcerp_app_vendor
   app_node_modules:
diff --git a/docker/entrypoint.sh b/docker/entrypoint.sh
index 774aad1..408ce29 100755
--- a/docker/entrypoint.sh
+++ b/docker/entrypoint.sh
@@ -24,10 +24,20 @@ echo "╚═══════════════════════
 # ---------------------------------------------------------------------------
 # Step 1: Fix storage permissions
 # ---------------------------------------------------------------------------
+# IMPORTANT: The storage/ directory is bind-mounted from the host.
+# On Windows/Mac, bind mounts may have root ownership that www-data can't
+# write to. We fix this by:
+#   1. Creating all required subdirectories
+#   2. Setting ownership to www-data (PHP-FPM runs as www-data)
+#   3. Creating an empty laravel.log if it doesn't exist
+# ---------------------------------------------------------------------------
 echo "▶ Step 1: Fixing storage permissions..."
 mkdir -p storage/logs storage/framework/cache/data storage/framework/sessions storage/framework/views bootstrap/cache
-chmod -R 775 storage bootstrap/cache
-chown -R www-data:www-data storage bootstrap/cache
+# Create the log file if it doesn't exist (ensures www-data can write)
+touch storage/logs/laravel.log 2>/dev/null || true
+chmod -R 777 storage bootstrap/cache 2>/dev/null || true
