@@ -21,6 +20,21 @@ server {
     # Client upload limits
     client_max_body_size 50M;
 
+    # ---------------------------------------------------------------------------
+    # Docker DNS resolver — allows nginx to resolve container names dynamically.
+    # 127.0.0.11 is Docker's built-in DNS server on the bridge network.
+    # valid=10s means cached DNS entries expire after 10 seconds, so nginx
