# =============================================================================
# RC_ERP_v2 — Docker Environment Variables
# =============================================================================
# Copy this file to .env (or use docker-compose --env-file):
#   cp .env.docker .env
#   docker-compose up -d
#
# These variables override the defaults in docker-compose.yml.
# =============================================================================

# PostgreSQL
POSTGRES_DB=rcerp
POSTGRES_USER=rcerp_app
POSTGRES_PASSWORD=rcerp_secret

# MySQL Archive (read-only legacy database)
MYSQL_ROOT_PASSWORD=archive_root_secret
MYSQL_DATABASE=rcerp_legacy
MYSQL_USER=archive_reader
MYSQL_PASSWORD=archive_reader_secret
